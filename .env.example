# YesiMan Tovskyy Infinity Quantum OS - Environment Variables Template
# Copia este archivo como .env y completa con tus valores reales
# IMPORTANTE: .env NO debe subirse a Git (está en .gitignore)

# =============================================================================
# API KEYS
# =============================================================================

# OpenAI API Key (para IA-script.py)
# Obtén tu key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL del Servidor Cuántico
QUANTUM_NETWORK_URL=https://yesimantovskyy-quantum-network.com/activar

# =============================================================================
# CONFIGURACIÓN DEL USUARIO
# =============================================================================

# Información del dispositivo
DISPOSITIVO=Windows 10

# Nombre del usuario
USUARIO=Vladyslav Yesimantovskyy

# Clave cuántica del sistema
CLAVE_CUANTICA=3^6^9_INFINITY_π_SECRET_KEY

# =============================================================================
# CONFIGURACIÓN DE DESARROLLO
# =============================================================================

# Modo debug (True/False)
DEBUG=True

# Entorno (development/production/testing)
ENV=development

# Nivel de logging (DEBUG/INFO/WARNING/ERROR/CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# CONFIGURACIÓN DE RED
# =============================================================================

# Timeout para peticiones HTTP (segundos)
TIMEOUT=30

# Máximo número de reintentos
MAX_RETRIES=3

# Puerto para servidor local (si aplica)
PORT=8000

# Host para servidor local (si aplica)
HOST=localhost

# =============================================================================
# CONFIGURACIÓN DE SEGURIDAD
# =============================================================================

# Salt para cifrado (genera uno único)
ENCRYPTION_SALT=tu_salt_unico_aqui

# Clave secreta para tokens (genera una única)
SECRET_KEY=tu_secret_key_unico_aqui

# =============================================================================
# CONFIGURACIÓN DE BASE DE DATOS (si aplica)
# =============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=sqlite:///./quantum_os.db

# =============================================================================
# CONFIGURACIÓN DE PRUEBAS
# =============================================================================

# Modo de pruebas (True/False)
TESTING=False

# Base de datos de pruebas (si aplica)
# TEST_DATABASE_URL=sqlite:///./test_quantum_os.db

# =============================================================================
# NOTAS
# =============================================================================

# 1. Nunca compartas este archivo con credenciales reales
# 2. Mantén .env en .gitignore
# 3. Usa valores diferentes para development y production
# 4. Genera keys seguras para production
# 5. Documenta cualquier variable nueva que agregues
