{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Crear entorno virtual Python",
            "type": "shell",
            "command": "python3 -m venv .venv",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Instalar dependencias",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pip", "install", "-r", "requirements.txt"],
            "problemMatcher": [],
            "dependsOn": "Crear entorno virtual Python",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Ejecutar activar.py",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/activar.py"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Ejecutar IA-script.py",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/IA-script.py"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Formatear código Python",
            "type": "shell",
            "command": "python",
            "args": ["-m", "black", "${workspaceFolder}"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Linter Python (flake8)",
            "type": "shell",
            "command": "python",
            "args": ["-m", "flake8", "${workspaceFolder}"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Tests Python",
            "type": "shell",
            "command": "python",
            "args": ["-m", "pytest", "-v"],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            }
        }
    ]
